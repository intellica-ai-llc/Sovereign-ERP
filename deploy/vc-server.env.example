# /etc/vc-server.env   (chmod 600, owner root). Never commit the real file.
VC_ADMIN_TOKEN=CHANGE-ME-at-least-24-random-characters
VC_DATA=/var/lib/vc-server
VC_ADDR=127.0.0.1:8080
# the public hostname customers use (also the passkey relying-party id): no scheme, no path
VC_HOST=log.example.com
# real-client header for rate limiting, set by YOUR proxy: Caddy -> x-real-ip (see Caddyfile in the runbook);
# Cloudflare Tunnel -> use VC_TRUST_CF=1 instead. Never point this at a header the client can choose.
VC_CLIENT_IP_HEADER=x-real-ip
# start the public market-data collector at boot (read-only)
VC_COLLECT=1
